{
    "name": "detain/phlix-server",
    "description": "Phlix media server - streaming, library management, user auth, and SyncPlay coordination",
    "type": "project",
    "license": "MPL-2.0",
    "require": {
        "php": ">=8.3",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-exif": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-gd": "*",
        "ext-hash": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-ldap": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-posix": "*",
        "ext-random": "*",
        "ext-simplexml": "*",
        "ext-sockets": "*",
        "ext-sodium": "*",
        "ext-zip": "*",
        "ext-zlib": "*",
        "crell/tukio": "^2.0",
        "detain/phlix-shared": "^0.49.0",
        "directorytree/ldaprecord": "^3.0",
        "james-heinrich/getid3": "^1.9",
        "justinrainbow/json-schema": "^5.2",
        "monolog/monolog": "^3.0",
        "php-di/php-di": "^7.0",
        "phpseclib/phpseclib": "^3.0",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "smarty/smarty": "^4.0",
        "symfony/process": "^7.0",
        "symfony/yaml": "^7.0",
        "web-auth/webauthn-lib": "^4.0",
        "web-token/jwt-framework": "^4.1",
        "webman/console": "^2.2",
        "workerman/http-client": "^3.1",
        "workerman/mysql": "^1.0",
        "workerman/redis": "^2.0",
        "workerman/webman-framework": "~2.2",
        "workerman/workerman": "~5.1"
    },
    "require-dev": {
        "codeception/codeception": "^5.3",
        "codeception/module-asserts": "^3.2",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.10",
        "vimeo/psalm": "^6.5"
    },
    "autoload": {
        "psr-4": {
            "Phlix\\": "src/"
        },
        "files": [
            "src/Plugins/AliasCompatShim.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Phlix\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/Fixtures/Plugins/fixture-plugin/"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform-check": true,
        "platform": {
            "php": "8.3.0",
            "ext-ctype": "8.3.0",
            "ext-curl": "8.3.0",
            "ext-dom": "8.3.0",
            "ext-exif": "8.3.0",
            "ext-fileinfo": "8.3.0",
            "ext-filter": "8.3.0",
            "ext-gd": "8.3.0",
            "ext-hash": "8.3.0",
            "ext-iconv": "8.3.0",
            "ext-json": "8.3.0",
            "ext-ldap": "8.3.0",
            "ext-libxml": "8.3.0",
            "ext-mbstring": "8.3.0",
            "ext-openssl": "8.3.0",
            "ext-pcntl": "8.3.0",
            "ext-pdo": "8.3.0",
            "ext-pdo_mysql": "8.3.0",
            "ext-posix": "8.3.0",
            "ext-random": "8.3.0",
            "ext-simplexml": "8.3.0",
            "ext-sockets": "8.3.0",
            "ext-sodium": "8.3.0",
            "ext-zip": "8.3.0",
            "ext-zlib": "8.3.0"
        }
    },
    "extra": {
        "phlix": {
            "minHubVersion": "1.0.0",
            "maxHubVersion": "1.9.9",
            "minPhpVersion": "8.3"
        }
    }
}

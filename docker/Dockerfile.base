# ============================================================================
# Phlix shared base image — Alpine + PHP + Swoole + UV + Composer
# ----------------------------------------------------------------------------
# This image carries the slow-to-build pieces: OS packages, PHP, and the
# Swoole and php-uv extensions (both compiled from source). It is built and
# published separately as `ghcr.io/detain/phlix-base` so the phlix-server and
# phlix-hub application images can `FROM` it without recompiling the PHP
# extensions every time their own Dockerfile changes.
#
# Rebuild/republish this image only when the toolchain or extension set
# changes. The compile layers below are cached (GHA + registry), so when this
# file is unchanged the base build job is a fast cache hit. See docker/README.md
# ("Base image") and .github/workflows/docker.yml.
# ============================================================================
ARG PHP_VERSION=8.3
# ----------------------------------------------------------------------------
# `-cli`, not `-fpm`. (S163 review F4)
#
# The runtime images run the Workerman daemon and nothing else, so php-fpm was
# dead weight — but not harmless dead weight: the `-fpm` flavour also carries
# `EXPOSE 9000`, which meant the "daemon-only" Alpine image still advertised an
# FPM port (visible on every `docker ps`), and it kept an `php-fpm` binary in
# the image that the S163 supervisord config used to point at. The unit test
# that was supposed to forbid nginx/php-fpm passed only because its data
# provider never scanned THIS file.
#
# Consequence for phlix-hub, which FROMs this same published base: its
# `[program:php-fpm]`/`[program:nginx]` lose their binaries. Those programs are
# already 100% non-functional there (`exit status 78` FATAL and a
# `fastcgi_pass` to a port nothing listens on — the same S163 defects), and the
# hub image BUILD is unaffected because its Dockerfile only COPYs config. It
# needs the same daemon-only treatment; recorded in the step worklog.
# ----------------------------------------------------------------------------
FROM php:${PHP_VERSION}-cli-alpine

# Install system deps and PHP extensions.
# `supervisor` stays — it is the process manager the runtime images use.
# `nginx` is GONE: nothing in the serving path uses it (docker/nginx.conf is
# deleted), and shipping it invited the two-serving-models confusion back.
RUN apk add --no-cache \
    supervisor \
    mysql-client \
    libzip-dev \
    oniguruma-dev \
    libpng-dev \
    curl \
    curl-dev \
    bash \
    tar \
    gzip \
    unzip \
    7zip \
    # Build tools for extensions
    cmake \
    autoconf \
    file \
    gcc \
    g++ \
    make \
    re2c \
    git \
    linux-headers \
    # Swoole dependencies
    openssl-dev \
    libuv-dev \
    brotli-dev \
    zstd-dev \
    nghttp2-dev \
    postgresql-dev \
    sqlite-dev \
    c-ares-dev \
    liburing-dev \
    libssh2-dev \
    # ext-ldap is a HARD requirement in composer.json ("ext-ldap": "*", used by
    # directorytree/ldaprecord for the LDAP auth provider). It was absent from
    # every image and masked by `composer install --ignore-platform-reqs`, so
    # `composer check-platform-reqs` failed inside the built image and any LDAP
    # code path would have fatalled at runtime. (S163)
    openldap-dev \
    && docker-php-ext-install \
        pdo \
        pdo_mysql \
        zip \
        gd \
        fileinfo \
        pcntl \
        posix \
        bcmath \
        sockets \
        ldap \
        # ext-exif is the SAME class of defect ext-ldap was, found by S314's
        # call-site derivation. `php:8.3-cli-alpine` does not enable exif, and
        # src/Media/Library/PhotoScanner.php:95 + BookScanner.php:306 call
        # exif_read_data() UNGUARDED — so every photo/PDF scan in the published
        # image would have fatalled with "Call to undefined function
        # exif_read_data()". Measured against ghcr.io/detain/phlix-base:latest
        # (PHP 8.3.33): exif was the ONLY member of the derived contract absent
        # from that image. Declaring `ext-exif` in composer.json is what turned
        # a silent runtime fatal into a build-time failure; this line is the fix.
        exif \
    && rm -rf /var/cache/apk/* /tmp/pear

# ----------------------------------------------------------------------------
# io_uring is OFF in the container by default. (S163; measurements corrected in
# S200 — the original note here recorded an A/B control that does not
# reproduce, and gave advice that is necessary but not sufficient.)
#
# A Swoole built `--enable-iouring --enable-uring-socket` hits TWO stacked
# blockers in a container. In the order they are REACHED:
#
#   1. seccomp. Docker's default profile BLOCKS io_uring_setup /
#      io_uring_enter / io_uring_register (removed from the allowlist by moby
#      for security), so the ring never opens at all:
#        ERROR  Iouring::Iouring(): Failed to initialize io_uring instance,
#               Error: Operation not permitted[1]
#
#   2. kernel version. Lift seccomp and the ring DOES open — and Swoole 6.2.1
#      then rejects the kernel, because its io_uring path uses ops added in 6.9:
#        ERROR  Iouring::Iouring(): The Iouring::ftruncate() requires `6.9`
#               or higher Linux kernel
#
# Both are fatal: the process exits 1. (S163 observed this at daemon level as
# every worker exiting and reforking, so :8096 never came up.) So turning
# seccomp off does NOT make an io_uring image serve on a pre-6.9 kernel — it
# only swaps blocker 1 for blocker 2 — and it was never an option anyway,
# because it disables syscall filtering for the whole container.
#
# Reproduce. The probe MUST force the ring with SWOOLE_HOOK_ALL; a bare
# `Swoole\Server` start never touches io_uring and so exits 0 on every arm,
# discriminating nothing:
#
#   docker run --rm --network none [--security-opt seccomp=unconfined] IMAGE \
#     php -r 'Swoole\Runtime::enableCoroutine(SWOOLE_HOOK_ALL); Swoole\Coroutine\run(fn() => print(strlen(file_get_contents("/etc/hostname")) . "\n"));'
#
# On a 6.8.0 host that prints error 1 under the default profile and error 2
# under `seccomp=unconfined`. It prints `13` and exits 0 only on an image built
# with SWOOLE_IOURING=0 (this default) — where `php --ri swoole` prints no
# io_uring line at all.
#
# The HOST build is deliberately NOT changed: `scripts/install.sh`
# (phlix_build_swoole) keeps `--enable-iouring --enable-uring-socket`, and
# `systemd/phlix-server.service` carries `LimitMEMLOCK=infinity` precisely so
# io_uring initialises there. This ARG is the one place the two diverge, and it
# is a runtime-sandbox difference, not a drift.
#
# Build with `--build-arg SWOOLE_IOURING=1` only if BOTH hold: your container
# runtime permits the io_uring syscalls (a custom seccomp profile, or
# `seccomp=unconfined`), AND the host kernel is >= 6.9. Permitting the syscalls
# is necessary but NOT sufficient — on an older kernel you get an image that
# exits 1 as soon as anything touches the ring.
# ----------------------------------------------------------------------------
ARG SWOOLE_IOURING=0

# ----------------------------------------------------------------------------
# PIN the from-source builds. (S163 review F9)
#
# These used to `git clone --depth=1` the DEFAULT BRANCH of both repositories,
# so the extension set in `phlix-base:latest` — a PUBLISHED artifact that
# phlix-server and phlix-hub both build on — changed silently whenever upstream
# pushed to master. Two builds of the same commit of this repo could produce
# different images, and a boot gate that passes today could fail tomorrow with
# no change here. Pinned to exactly what the S163 boot runs validated.
#
# To move: bump the ref, rebuild the base, and re-run
# `scripts/docker-boot-smoke.sh` for all three images.
# ----------------------------------------------------------------------------
ARG SWOOLE_REF=v6.2.1
ARG PHP_UV_REF=670a609efc36c9043be37bae4126f06ed30fde21

# Build and install swoole
RUN git clone --depth=1 --branch "${SWOOLE_REF}" https://github.com/swoole/swoole-src.git /tmp/swoole \
    && cd /tmp/swoole \
    && phpize \
    && IOURING_FLAGS="" \
    && if [ "$SWOOLE_IOURING" = "1" ]; then \
           IOURING_FLAGS="--enable-iouring --enable-uring-socket"; \
       fi \
    && ./configure \
        --enable-swoole \
        --enable-sockets \
        --enable-mysqlnd \
        --enable-swoole-curl \
        --enable-cares \
        --enable-swoole-pgsql \
        --with-openssl-dir=/usr \
        --with-nghttp2-dir=/usr \
        --enable-swoole-sqlite \
        --enable-swoole-coro-time \
        --enable-zstd \
        --enable-brotli \
        $IOURING_FLAGS \
        --with-swoole-ssh2 \
        --enable-swoole-ftp \
    && make -j$(nproc) \
    && make install \
    && echo "extension=swoole.so" > /usr/local/etc/php/conf.d/docker-php-ext-swoole.ini \
    && cd / && rm -rf /tmp/swoole

# Build and install uv (php-uv)
RUN git clone https://github.com/bwoebi/php-uv.git /tmp/php-uv \
    && cd /tmp/php-uv \
    && git checkout --quiet "${PHP_UV_REF}" \
    && phpize \
    && ./configure --with-uv \
    && make -j$(nproc) \
    && make install \
    && echo "extension=uv.so" > /usr/local/etc/php/conf.d/docker-php-ext-uv.ini \
    && cd / && rm -rf /tmp/php-uv

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

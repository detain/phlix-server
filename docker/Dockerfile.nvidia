# ============================================================================
# Phlix Server — NVIDIA (CUDA) hardware acceleration build
# ----------------------------------------------------------------------------
# Path layout note: this variant inherits from `nvidia/cuda:*` (Ubuntu 24.04)
# instead of the Alpine-based `php:8.3-fpm-alpine`. NVIDIA's CUDA runtime
# requires a glibc-based distribution, so the official php:* image cannot
# be used as the base. As a consequence:
#
#   * PHP config lives under `/etc/php/8.3/` (Debian/Ubuntu layout), not
#     `/usr/local/etc/php/conf.d/` (Alpine layout used by `Dockerfile`).
#   * To keep operator-facing paths identical to the Alpine image, we symlink
#     the Alpine-style path to the Ubuntu-style file so that documentation and
#     entrypoint scripts can target a single canonical location.
#
# SERVING MODEL (S163): this image runs the Workerman daemon (`start.php`) and
# NOTHING else — no nginx, no php-fpm. See docker/supervisord.conf's header for
# the evidence; the same `php-fpm -F` / `fastcgi_pass 127.0.0.1:9000` pair that
# made every request 502 here is deleted rather than patched.
#
# Rationale recorded in: docker/README.md
# ============================================================================
FROM nvidia/cuda:12.9.2-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive

# php-cli only — the daemon is a CLI process. php-fpm and nginx are gone with
# the serving model. php-ldap satisfies composer.json's hard "ext-ldap" require
# (previously masked by --ignore-platform-reqs); php-curl/php-mbstring back
# vendor packages that were equally masked.
RUN apt-get update && apt-get install -y \
    php-cli \
    php-mysql \
    php-zip \
    php-gd \
    php-bcmath \
    php-xml \
    php-curl \
    php-mbstring \
    php-ldap \
    supervisor \
    ffmpeg \
    curl \
    ca-certificates \
    bash \
    tar \
    gzip \
    unzip \
    p7zip-full \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# /var/run/phlix is `worker.pid_file`'s directory in config/server.php; the
# daemon runs as `nobody` and cannot create it itself. Mirrors the systemd
# unit's RuntimeDirectory=phlix.
RUN mkdir -p /var/www/html /var/phlix/config /var/phlix/data /var/phlix/logs /var/phlix/backups \
        /var/run/phlix \
    && chown -R nobody:nogroup /var/www/html /var/phlix /var/run/phlix

# Ubuntu PHP layout. The ini MUST land in the CLI scan dir: it used to be
# written to `/etc/php/8.3/fpm/conf.d/`, which the daemon never reads, so every
# setting in docker/php.ini was inert for the application. Symlinked to the
# Alpine canonical path so downstream tooling can rely on a single location.
COPY docker/php.ini /etc/php/8.3/cli/conf.d/99-phlix.ini
RUN mkdir -p /usr/local/etc/php/conf.d \
    && ln -sf /etc/php/8.3/cli/conf.d/99-phlix.ini /usr/local/etc/php/conf.d/zz-phlix.ini

COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# supervisord is started with an explicit `-c`, but a bare `supervisorctl` reads
# its OWN default search path — which is why `supervisorctl status` answered
# "unix:///run/supervisord.sock no such file" while the container reported Up,
# i.e. the one command an operator reaches for was useless. Point both distro
# defaults at the same file.
RUN mkdir -p /etc/supervisor \
    && ln -sf /etc/supervisor/conf.d/supervisord.conf /etc/supervisord.conf \
    && ln -sf /etc/supervisor/conf.d/supervisord.conf /etc/supervisor/supervisord.conf

WORKDIR /var/www/html

COPY . /var/www/html/

# Composer install — fail the build on error. `--ignore-platform-reqs` is
# deliberately NOT passed; see the package list above.
#
# S314: `composer check-platform-reqs` is what keeps that S163 property alive.
# composer.json now sets `config.platform`, which pins the resolution platform
# so every machine produces the same lock — and, as a side effect, makes
# `composer install` stop checking the REAL extension set (it believes the
# override). `check-platform-reqs` does NOT honour the override: it reports the
# actual environment, so a missing extension fails the BUILD here rather than
# surfacing as a platform_check.php fatal the first time the daemon boots.
# Measured: a build against a base without ext-exif passes `composer install`
# and fails this command with `ext-exif ... missing`.
RUN composer install --no-dev --optimize-autoloader \
    && composer check-platform-reqs --no-dev \
    && mkdir -p /var/www/html/.logs /var/www/html/templates_c /var/www/html/var \
    && chown -R nobody:nogroup /var/www/html

# The CMD below names `/docker-entrypoint.sh`; `COPY . /var/www/html/` lands it
# at /var/www/html/docker/docker-entrypoint.sh. Without this line the CMD
# resolved to nothing and no container ever ran the entrypoint (S159 review
# finding 4). Asserted by tests/Unit/Docker/DockerEntrypointTest.php.
COPY docker/docker-entrypoint.sh /docker-entrypoint.sh

# The ports start.php actually binds. `EXPOSE 80 443` described the deleted
# nginx; nothing has ever listened on 443.
EXPOSE 8096 8097

# start-period must be long enough that a first boot's migration chain does
# not flap the container to `unhealthy`, and SHORT enough that `unhealthy` is
# actually reachable while anyone is watching. 180s failed the second test:
# it outlived an entire boot-gate run, so the state could never go bad and
# `healthy` meant nothing (S163 review F1). Migrations run BEFORE supervisord
# starts the daemon, and the daemon itself serves ~20s after that, so 90s is
# ample in steady state; a slow first migration merely delays `healthy`,
# because failures inside the start period are not counted.
# scripts/docker-boot-smoke.sh asserts this stays <= MAX_START_PERIOD.
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8096/health || exit 1

CMD ["sh", "/docker-entrypoint.sh"]

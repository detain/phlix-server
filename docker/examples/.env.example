# Database passwords (change these!)
MYSQL_ROOT_PASSWORD=change_me_in_production
PHLIX_DB_PASSWORD=change_me_in_production
HUB_DB_PASSWORD=change_me_in_production

# Application secrets.
#
# PHLIX_SECRET_KEY is mapped onto JWT_SECRET by docker/docker-entrypoint.sh and
# signs BOTH JWTs and media signed URLs. It used to carry a placeholder value
# here; because that value is committed to a public repository, anyone could
# forge tokens on any server that kept it. The entrypoint now REFUSES TO START
# on `change_me*` and friends.
#
# Leave it UNSET (as below) and the entrypoint generates a strong key on first
# boot and persists it to /var/phlix/config/jwt_secret — mount that volume and
# it survives restarts. Only set it if you want to manage the key yourself:
#
#   PHLIX_SECRET_KEY=$(openssl rand -hex 32)
#
#PHLIX_SECRET_KEY=

# HUB_SECRET_KEY carried the IDENTICAL committed placeholder one line below the
# one above until S163 review round 2 (finding 7). No PHP in phlix-server or
# phlix-hub reads it today, which is precisely the state PHLIX_SECRET_KEY was in
# before the entrypoint mapping made it load-bearing — i.e. the latent form of
# the same defect. Shipping no value is the only version of this line that
# cannot become a public signing key by accident.
#
#   HUB_SECRET_KEY=$(openssl rand -hex 32)
#
#HUB_SECRET_KEY=

# Optional: Hub pairing code (get from hub dashboard)
PHLIX_HUB_PAIRING_CODE=

# Xdebug debugging (default: off)
# Options: off, develop, trace, debug
# Can combine: "develop,trace"
XDEBUG_MODE=off
#
# XDEBUG_TRIGGER is the shared value a request must carry to start a debug
# session (docker/php.ini:79 -> xdebug.trigger_value). It shipped here as
# `your-secret-trigger-value`, i.e. a committed placeholder — inert only
# because XDEBUG_MODE defaults to off, which is exactly the latent shape of
# the PHLIX_SECRET_KEY defect (S163 review round 3, finding 4). It has a
# built-in default (`devdebug`), so leaving it unset changes nothing; set your
# own when you turn Xdebug on:
#
#   XDEBUG_TRIGGER=$(openssl rand -hex 12)
#
#XDEBUG_TRIGGER=

# Container image pins (required since S475).
#
# Every example compose in this directory resolves its ghcr images through these
# two variables with `${VAR:?…}` interpolation: unset or empty and `docker
# compose` fails immediately, naming the variable and the tag form it expects.
# That is BY DESIGN — the examples used to reference mutable tags that silently
# drifted with every push, so a "reproducible" example was reproducible only
# until the next release. They now refuse anything but an explicit immutable pin.
#
# Substitute the hex; the angle brackets are placeholders:
#
#   PHLIX_SERVER_IMAGE=ghcr.io/detain/phlix-server:<full-sha>-<latest|intel|nvidia>
#   PHLIX_HUB_IMAGE=ghcr.io/detain/phlix-hub:<sha12>
#
# How to find a current tag: list the published ones anonymously —
#   GET https://ghcr.io/v2/detain/phlix-server/tags/list (same path for phlix-hub) —
# or take the full commit SHA of a docker-workflow run from the repository's
# Actions tab: the server images are published per run as <full-sha>-latest (and
# the -intel / -nvidia hardware variants), the hub as the first 12 SHA chars.
# Deliberately left commented out below: an active placeholder here would defeat
# the loud gate this exists to enforce.
#
#PHLIX_SERVER_IMAGE=
#PHLIX_HUB_IMAGE=

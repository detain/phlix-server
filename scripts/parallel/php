#!/usr/bin/env bash
# S457 (prototype) — PATH shim giving every parallel PHPUnit child a private
# TMPDIR BEFORE PHP starts (sys_get_temp_dir() binds TMPDIR once at process
# startup; a later putenv() is provably inert — measured on PHP 8.3.6).
# paraunit launches children as argv `php <phpunit-bin> …` found via PATH and
# exports PARAUNIT_PROCESS_UNIQUE_ID (md5 of the chunk's test files) per child.
# Usage: PATH="<repo>/scripts/parallel:$PATH" vendor/bin/paraunit run …
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
real_php="${PHLIX_REAL_PHP:-}"
if [ -z "$real_php" ]; then
    # Resolve php with THIS directory removed from PATH — otherwise the exec
    # below finds the shim itself and recurses forever.
    trimmed_path="$(printf '%s' "$PATH" | tr ':' '\n' | awk -v d="$here" '$0!=d' | paste -sd:)"
    real_php="$(PATH="$trimmed_path" command -v php)" || {
        echo "php-shim: no real php found on PATH (after removing $here)" >&2
        exit 127
    }
fi
# S457 — BOTH seams are gated on the chunk id, so the shim is fully inert for anyone else.
# run-suite.sh sets TMPDIR to the shared base for the paraunit PARENT and exports
# PARAUNIT_PROCESS_UNIQUE_ID only in each child; a plain `php` (or the parent) must leave
# TMPDIR exactly as inherited and argv untouched. Redirecting unconditionally would litter
# ${PHLIX_TEST_TMP_BASE:-/tmp}/worker-$$ and, with the base unset, /tmp itself — and would
# silently re-point the parent's TMPDIR away from the base run-suite.sh chose for it.
if [ -n "${PARAUNIT_PROCESS_UNIQUE_ID:-}" ]; then
    tmp_base="${PHLIX_TEST_TMP_BASE:-/tmp}"
    export TMPDIR="${tmp_base}/worker-${PARAUNIT_PROCESS_UNIQUE_ID}"
    mkdir -p "$TMPDIR"
fi

# S457 — per-child JUnit seam. run-suite.sh passes
#   --pass-through=--log-junit=.phpunit-junit/junit-__PHLIX_WORKER__.xml
# Every child shares the repo root as CWD, so a fixed --log-junit path would be a
# last-writer-wins clobber of the merged evidence the CI gate reads. paraunit exports
# PARAUNIT_PROCESS_UNIQUE_ID (md5 of the chunk) per child, so the shim — which already
# sits on PATH for every child — rewrites the token to that id. The parent paraunit
# process and any non-parallel invocation have the variable unset and pass through
# untouched (argv AND environment).
if [ -n "${PARAUNIT_PROCESS_UNIQUE_ID:-}" ]; then
    expanded=()
    for arg in "$@"; do
        expanded+=("${arg//__PHLIX_WORKER__/${PARAUNIT_PROCESS_UNIQUE_ID}}")
    done
    set -- "${expanded[@]}"
fi

exec "$real_php" "$@"

[Unit]
Description=Phlix Media Server
Documentation=https://docs.phlix.media
After=network.target mysql.service
Wants=mysql.service
StartLimitIntervalSec=500
StartLimitBurst=5

[Service]
Type=simple
User=phlix
Group=phlix
WorkingDirectory=/var/www/phlix
ExecStart=/usr/bin/php /var/www/phlix/start.php start
ExecReload=/bin/kill -SIGUSR1 $MAINPID
ExecStop=/bin/kill -SIGTERM $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30
TimeoutStartSec=30

# Swoole 6's io_uring event loop pins locked memory; the default 8 MB
# RLIMIT_MEMLOCK is too small for the worker pool, so io_uring init fails
# with ENOMEM and workers intermittently drop connections (random 502s).
# Lift the cap so io_uring initialises cleanly.
LimitMEMLOCK=infinity

Environment="PHLIX_ENV=production"
# Persistent, writable cache dir for the anidb plugin's offline title-dump
# index (title_index.json). The plugin reads this env (after an explicit ctor
# arg / cache_dir setting) before falling back to sys_get_temp_dir(); pointing
# it at /var/cache/phlix/anidb (also in ReadWritePaths below) gives it a real
# persistent home instead of PrivateTmp's per-start scratch.
Environment="PHLIX_ANIDB_CACHE_DIR=/var/cache/phlix/anidb"
EnvironmentFile=/etc/phlix/env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=phlix-server

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Writable paths: /var/phlix (data), /var/log/phlix (logs),
# /var/run/phlix (pid_file in config/server.php), the install dir's
# .logs/ + templates_c/ (stdout log + Smarty compile cache), var/
# (runtime plugin installs in var/plugins + ui-theme extraction in var/themes),
# and /var/artwork (local TMDB poster cache — config/artwork.php's
# ARTWORK_STORAGE_PATH default). Without /var/artwork the scanner fails with
# "mkdir(): Read-only file system" and, because nothing ever caches, re-downloads
# every poster on every scan — flooding the concurrent matcher with blocking
# cURL until Swoole aborts with "all coroutines are asleep - deadlock".
# /var/subtitles is the DOWNLOADED external-subtitle store (config/subtitles.php's
# SUBTITLE_STORAGE_PATH default); without it here ProtectSystem=strict keeps it
# read-only and the on-demand subtitle download write fails (the /var/artwork lesson).
# /var/cache/phlix/anidb is the anidb plugin's persistent title-dump cache
# (PHLIX_ANIDB_CACHE_DIR above); without it here ProtectSystem=strict keeps it
# read-only and the plugin's index write fails (the /var/artwork lesson).
ReadWritePaths=/var/phlix /var/log/phlix /var/run/phlix /var/www/phlix/.logs /var/www/phlix/templates_c /var/www/phlix/var /var/artwork /var/subtitles /var/cache/phlix/anidb
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
# Have systemd create + chown /run/phlix on each start.
RuntimeDirectory=phlix
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target

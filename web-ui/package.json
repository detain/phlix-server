        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@phlix/ui": "github:detain/phlix-ui#v0.1.0"
    },
    "devDependencies": {
        "@types/node": "^20.11.30",
        "@vitejs/plugin-vue": "^5.0.4",
        "@vue/tsconfig": "^0.5.1",
        "typescript": "^5.4.3",
        "vite": "^8.0.16",
        "vue": "^3.4.0",
        "vue-tsc": "^2.0.7"
    }
}

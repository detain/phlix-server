{
    "name": "@phlix/server-web-ui",
    "version": "0.1.0",
    "private": true,
    "description": "Thin Vue 3 + Vite consumer of @phlix/ui, serving the shared Phlix SPA at /app/*",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
